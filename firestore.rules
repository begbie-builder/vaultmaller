rules_version = '2';

// ============================================================
//  Vaultmall Firestore security rules
//  THIS is what guarantees one user can never see another's
//  vault. Every document under users/{uid} may only be read or
//  written by the signed-in user whose uid matches. Paste these
//  into Firebase console → Firestore → Rules and click Publish
//  (README Step 1f).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // A user may only touch their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Any nested collections a user might add later stay private too.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
